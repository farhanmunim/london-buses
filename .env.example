# Copy to .env and fill in — .env is gitignored and never committed.
# In CI these come from GitHub Actions secrets; in Cloudflare Pages,
# BODS_API_KEY is set as a Pages environment variable (used by
# functions/api/live/vehicles.js). None of these keys ever reach the browser.

# TfL Unified API app key — https://api-portal.tfl.gov.uk (free tier)
BUS_API_KEY=

# DVLA Vehicle Enquiry Service key — https://developer-portal.driver-vehicle-licensing.api.gov.uk (free tier)
DVLA_API_KEY=

# DfT Bus Open Data Service key — https://data.bus-data.dft.gov.uk (free)
# Only needed by the Cloudflare Pages Function for live bus positions.
BODS_API_KEY=
