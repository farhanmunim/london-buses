# Copy to .env and fill in — .env is gitignored and never committed.
# In CI these come from GitHub Actions secrets. BODS_API_KEY (and, for the
# street-works receiver, GITHUB_REPO + GITHUB_TOKEN) are set on the host that
# runs the two /api endpoints — see SETUP.md. None of these keys ever reach
# the browser.

# TfL Unified API app key — https://api-portal.tfl.gov.uk (free tier)
BUS_API_KEY=

# DVLA Vehicle Enquiry Service key — https://developer-portal.driver-vehicle-licensing.api.gov.uk (free tier)
DVLA_API_KEY=

# DfT Bus Open Data Service key — https://data.bus-data.dft.gov.uk (free)
# Only needed by the /api/live/vehicles endpoint for live bus positions.
BODS_API_KEY=

# DfT D-TRO service (digital traffic regulation orders) — register at
# d-tro.dft.gov.uk; the app id + key/secret pair mint an OAuth token.
# Only needed by scripts/fetch-dtro.js (soft-skips without them).
DTRO_CLIENT_ID=
DTRO_API_KEY=
DTRO_CLIENT_SECRET=
